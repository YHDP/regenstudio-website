trial.html
trial2.html
trial.css
trial2.css
trial.js
trial2.js

# Local DPA test content (copied from Proton Drive — do not commit).
# Glob patterns rather than per-client filenames so the .gitignore itself
# carries no client identifiers (a leak vector flagged 2026-05-04).
dpa-test-content/
dpa-test-*.html
dpa-test-*-contract.html

# Internal QA / audit-log artifacts (multi-round fixed-point-audit reports
# per phase). Process notes, not visitor-facing content. Source of truth for
# long-term retention is Proton Drive AI-Operations/audit-archives/.
audit-log/

# DPA encryption pipeline test scripts — infrastructure tooling that exercises
# Edge Functions / Postgres directly. Lives in repo for dev convenience but
# never served. Promote to Proton Drive scripts/ if it stabilises.
scripts/test-dpa-encryption-pipeline.*
design-lab/
dpa/
dpa-test-content
dpa-rendering-lab/
node_modules/
package*.json

# JPA (Joint Project Agreement) signing flow — admin ops tool + test content.
# The 4 Edge Functions live on Proton Drive (private). The generic rendering
# JS (scope-pdf-builder.js, scope-pdf-renderer.js, scope-md-render.js) IS
# tracked because it contains no agreement text, only rendering infrastructure.
# Per user directive: nothing engagement-text-related lives in the public repo.
scope/
scope-test-content/
scope-test-*.html

# Blog comment-stage: drafts rendered with the production template + the
# review widget. _comment-stage/ is the LOCAL plaintext preview — NEVER push
# (also hard-blocked by the pre-push INTERNAL_PATHS_RE). _review/ is the
# password-ENCRYPTED deploy artifact: gitignored by default; deploying it is a
# deliberate `git add -f` + explicit-authorisation push (it is ciphertext, no
# readable draft). The widget partial is dev tooling, never served raw.
_comment-stage/
_review/
scripts/comment-stage-widget.html

# ui-screenshot artifacts (binary diffs — never commit)
.screenshots/

# Internal logo-placement lab (not for publish)
_logo-placer/

# Consent-aware pre-push guard: local pointer to the operator's consent manifest
# (_index.json on Proton Drive). Gitignored so this PUBLIC repo never carries the
# operator's local path/email. If absent, the client-identifier guard fails CLOSED
# (blocks every client name, as before). Set via $REGEN_CONSENT_MANIFEST instead if
# preferred.
scripts/hooks/.consent-manifest-path

# Private canary registry: distinctive phrases seeded into public content to later
# test whether AI models trained on regenstudio.world. A private measurement
# instrument — the file itself declares "never commit to the public repo".
scripts/hooks/.canary-registry
