#!/bin/bash
# Pre-push security hook for Regen Studio Website
# Scans staged commits for suspicious patterns before pushing to remote.
# To bypass (emergency only): git push --no-verify

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo "Running pre-push security scan..."
echo ""

ISSUES=0

# Get the range of commits being pushed
remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — compare against origin/main (or local main) so we see every
    # commit that's new on this branch. The previous default of just "$local_sha"
    # gave an empty diff (git diff <sha> compares sha to working tree, which equals
    # sha after commit), so the gate silently passed everything.
    if git rev-parse --verify --quiet origin/main >/dev/null; then
      range="origin/main..$local_sha"
    elif git rev-parse --verify --quiet main >/dev/null; then
      range="main..$local_sha"
    else
      # No reference point at all (brand-new repo). Scan everything reachable.
      range="$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | head -1)..$local_sha"
      [ "$range" = "..$local_sha" ] && range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  # Get the diff of all commits being pushed.
  # Excludes node_modules and assets/js/vendor/* (vendored MIT bundles whose
  # internal `fetch(` polyfills + minified content trip exfil + secret regexes
  # — license review happens in NOTICE.md, not the line-level scan).
  DIFF=$(git diff "$range" -- '*.html' '*.js' '*.ts' '*.json' '*.css' '*.md' '*.txt' '*.sh' '*.toml' '*.yml' '*.yaml' '*.env*' ':!node_modules/*' ':!assets/js/vendor/*' 2>/dev/null)

  if [ -z "$DIFF" ]; then
    continue
  fi

  # 1. Check for external script/link tags (CDN, Google Fonts, etc.)
  #    Allowlist also covers the public Kamerstuk source (tweedekamer.nl) and
  #    the publicly-credited Clean Fuel Protocol consortium partner domains
  #    (rvo.nl, tno.nl, coe-dpp.nl, fides-labs.io) — sanctioned editorial links
  #    in a government-referenced retrospective; added 2026-05-19 (Yvo approved).
  #
  #    2026-05-20: extended for the trilingualisation sweep:
  #    - eur-lex.europa.eu — official EU regulation citations (ESPR/PPWR/CPR/
  #      Battery/Toy/Detergents; ubiquitous across trilingual public DPP pages).
  #    - Slimstrandnet case-study sanctioned editorial sources (denhaag.nl,
  #      vng.nl, rijksoverheid.nl, acm.nl, platform31.nl, stedin.net,
  #      amsterdamsmartcity.com, energy.nl, forthefutureofenergy.nl, gridflex.nl,
  #      gebiedsontwikkeling.nu, nvde.nl, openremote.io, smart-energy.com,
  #      schoonschipamsterdam.org, kerstentechniek.nl, kansenvoorwest.nl) —
  #      noindex client knowledge-platform references public news + municipal
  #      documents about the Scheveningen smart-microgrid project.
  #    2026-05-28: extended for the EU DPP Registry IR consultation post:
  #    - eprel.ec.europa.eu — official EU energy-labelling product registry.
  #    - digital-strategy.ec.europa.eu — DG CONNECT policy pages (EUDI Wallet).
  #    - reach-it.echa.europa.eu — ECHA REACH-IT submission portal.
  #    - echa.europa.eu — ECHA broader (SCIP database, etc.).
  #    - circulartechforum.de — CircularTech Forum partner site, joint-submission
  #      co-author credited in the DPP Registry IR consultation post.
  #    User-clicked <a href> hyperlinks are not exfil vectors, but the regex
  #    matches them anyway; allowlisting sanctioned domains is the targeted fix.
  EXTERNAL_TAGS=$(echo "$DIFF" | grep -n '^\+' | grep -iE '(src|href)="https?://' | grep -viE '(supabase\.co|regenstudio\.(world|space)|player\.vimeo\.com|w\.soundcloud\.com|linkedin\.com|bsky\.app|mastodon\.social|schema\.org|ogp\.me|github\.com/YHDP/regenstudio-website|tweedekamer\.nl|rvo\.nl|tno\.nl|coe-dpp\.nl|fides-labs\.io|eur-lex\.europa\.eu|denhaag\.nl|smartcity\.denhaag\.nl|denhaag\.raadsinformatie\.nl|vng\.nl|rijksoverheid\.nl|acm\.nl|platform31\.nl|stedin\.net|amsterdamsmartcity\.com|energy\.nl|forthefutureofenergy\.nl|gridflex\.nl|gebiedsontwikkeling\.nu|nvde\.nl|openremote\.io|smart-energy\.com|schoonschipamsterdam\.org|kerstentechniek\.nl|kansenvoorwest\.nl|eprel\.ec\.europa\.eu|digital-strategy\.ec\.europa\.eu|reach-it\.echa\.europa\.eu|echa\.europa\.eu|circulartechforum\.de)' || true)
  if [ -n "$EXTERNAL_TAGS" ]; then
    echo -e "${RED}BLOCKED: External URL(s) found in added lines:${NC}"
    echo "$EXTERNAL_TAGS" | head -10
    echo ""
    ISSUES=$((ISSUES + 1))
  fi

  # 2. Check for fetch/XMLHttpRequest to non-Supabase domains.
  #    Excludes: supabase.co (Edge Functions), regenstudio.world / same-origin
  #    relative-path fetches (e.g., `fetch('assets/...')`, `fetch('/locales/...')`),
  #    explicit `// same-origin` annotations on the line.
  #    Tightened 2026-05-11: relative-path exception now accepts both
  #    `fetch('foo')` and `fetch('/foo')` (leading slash for root-relative),
  #    and allows string-concat continuation (no longer requires `)`
  #    immediately after the close quote — so `fetch('/foo' + lang + '.json')`
  #    is also recognized as same-origin via its literal prefix.
  #    2026-05-20: char class extended to allow leading `.` so dot-relative
  #    paths from /nl/ or /pt/ depth (e.g. `fetch('../../Blogs/blogs.json')`
  #    on the NL/PT digital-identities blog grid) count as same-origin.
  EXFIL=$(echo "$DIFF" | grep -n '^\+' | grep -iE '(fetch\(|XMLHttpRequest|navigator\.sendBeacon|new Image\(\)\.src)' | grep -viE 'supabase\.co|regenstudio\.(world|space)|same-origin|fetch\(['"'"'"][/.a-zA-Z][a-zA-Z0-9_/.-]*['"'"'"]' || true)
  if [ -n "$EXFIL" ]; then
    echo -e "${YELLOW}WARNING: Potential data exfiltration pattern:${NC}"
    echo "$EXFIL" | head -10
    echo ""
    ISSUES=$((ISSUES + 1))
  fi

  # 3. Check for secrets patterns
  #    - Stripe (sk_/pk_live/test)
  #    - Mollie (live_/test_ with 25+ char alphanumeric body)
  #    - PEM private keys
  #    - JWT-shaped tokens (Supabase service role / anon)
  #    - Assignments of *_KEY / *_SECRET / *_TOKEN / *_HASH to a long value
  #    - Inline quoted passwords
  SECRETS=$(echo "$DIFF" | grep -n '^\+' | grep -iE '(sk_(live|test)_[A-Za-z0-9]{20,}|pk_(live|test)_[A-Za-z0-9]{20,}|[^A-Za-z0-9_](live|test)_[A-Za-z0-9]{25,}|-----BEGIN|PRIVATE KEY|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|(SERVICE_ROLE_KEY|API_KEY|API_TOKEN|_SECRET|AUTH_TOKEN|PASSWORD_HASH|WEBHOOK_SECRET)\s*[:=]\s*["\x27]?[A-Za-z0-9_+/=.-]{20,}|password\s*=\s*["\x27][^\x27"]+["\x27])' || true)
  if [ -n "$SECRETS" ]; then
    echo -e "${RED}BLOCKED: Potential secret/key found:${NC}"
    echo "$SECRETS" | head -10
    echo ""
    ISSUES=$((ISSUES + 1))
  fi

  # 4. Check for CSP modifications (someone weakening security headers).
  # Audit F-10 fix (2026-05-24): promoted from warning to hard block. CSP
  # weakening must be deliberate; bypass via --no-verify if intentional.
  #
  # 2026-05-28: scope the check to *modified* files only. New files (e.g.
  # build.ts emitting a new /blog/<slug>/index.html) embed the standard
  # site-wide CSP by construction — every line of a brand-new file is a
  # "+" line, so the original check false-positives on every blog post add.
  # Genuine CSP weakening only happens via modifications to existing files
  # (changing the existing CSP string) or via build.ts itself, both of which
  # produce M-status, not A-status, diffs against the previous tip.
  MODIFIED_HTML=$(git diff --name-only --diff-filter=M "$range" -- '*.html' 2>/dev/null)
  if [ -n "$MODIFIED_HTML" ]; then
    CSP_DIFF=$(git diff "$range" -- $MODIFIED_HTML 2>/dev/null)
    CSP_CHANGES=$(echo "$CSP_DIFF" | grep -n '^\+' | grep -i 'Content-Security-Policy' || true)
    if [ -n "$CSP_CHANGES" ]; then
      echo -e "${RED}BLOCKED: CSP header modified — verify and re-push with --no-verify if intentional:${NC}"
      echo "$CSP_CHANGES" | head -5
      echo ""
      echo -e "${YELLOW}  CSP changes are security-relevant. Review the diff line-by-line:${NC}"
      echo -e "${YELLOW}    - Adding 'unsafe-eval' / 'unsafe-hashes' / wildcard sources is regression.${NC}"
      echo -e "${YELLOW}    - Removing 'frame-ancestors' / 'object-src' / 'base-uri' weakens clickjacking + injection defense.${NC}"
      echo -e "${YELLOW}    - Widening connect-src / form-action allowlists is data-exfil risk.${NC}"
      ISSUES=$((ISSUES + 1))
    fi
  fi

  # Audit F-15 fix (2026-05-24): explicit named-secret pattern. Catches
  # accidental commit of env-var values for: YVO_SIG_SECRET, CONSENT_FP_PEPPER,
  # MANIFEST_EXPORT_SECRET, LETTERMINT_API_TOKEN, IP_HASH_PEPPER,
  # DPA_ADMIN_SECRET, JPA_ADMIN_SECRET, LETTERMINT_WEBHOOK_SECRET,
  # NEWSLETTER_SEND_SECRET. The generic _SECRET / _KEY pattern in check #3
  # caught these IF assigned to that exact suffix, but not when assigned to a
  # different name (`const yvoSig = "..."`) or embedded in JSON.
  NAMED_SECRETS=$(echo "$DIFF" | grep -n '^\+' | grep -iE '(YVO_SIG_SECRET|CONSENT_FP_PEPPER|MANIFEST_EXPORT_SECRET|LETTERMINT_API_TOKEN|IP_HASH_PEPPER|DPA_ADMIN_SECRET|JPA_ADMIN_SECRET|LETTERMINT_WEBHOOK_SECRET|NEWSLETTER_SEND_SECRET)[\"\x27]?\s*[:=]\s*[\"\x27]?[A-Za-z0-9_+/=.-]{20,}' || true)
  if [ -n "$NAMED_SECRETS" ]; then
    echo -e "${RED}BLOCKED: Named secret with value in added line:${NC}"
    echo "$NAMED_SECRETS" | head -10
    echo ""
    echo -e "${YELLOW}  These env-var values must live ONLY in Supabase secrets,${NC}"
    echo -e "${YELLOW}  never in repo source. Use \`supabase secrets set NAME=value\`.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # Audit F-21 fix (2026-05-24): base64-blob scanner. A YVO_SIG_SECRET PNG
  # inlined as a string literal (or any other secret encoded base64) would slip
  # past the named-pattern checks. Catch any added line with 300+ chars of
  # contiguous base64 alphabet (plus optional trailing padding). 300 chars ≈
  # 225 bytes — well under a real PNG but well above any innocent base64 in
  # the repo (favicons + inline assets are size-bounded by their stylesheets,
  # not inlined in JS / HTML diffs).
  # NB: the count is split {200}{100,} rather than {300,} because BSD grep
  # (macOS) caps a single interval at 255 (RE_DUP_MAX) and errors out on
  # {300,} — which silently disabled this whole scanner on macOS until the
  # 2026-06-10 audit caught it. Both sub-counts are ≤255; the 300-char floor
  # is preserved.
  BASE64_BLOBS=$(echo "$DIFF" | grep -n '^\+' | grep -vE '^\+\+\+' | grep -E '[A-Za-z0-9+/]{200}[A-Za-z0-9+/]{100,}={0,2}' || true)
  if [ -n "$BASE64_BLOBS" ]; then
    echo -e "${RED}BLOCKED: Large base64 blob in added line:${NC}"
    echo "$BASE64_BLOBS" | head -5
    echo ""
    echo -e "${YELLOW}  300+ char contiguous base64 looks like an inlined PNG, certificate,${NC}"
    echo -e "${YELLOW}  or encoded secret. Move to assets/ as a binary file or to Supabase${NC}"
    echo -e "${YELLOW}  secrets / Proton Drive. If it's legitimate (e.g. a vendor-shipped${NC}"
    echo -e "${YELLOW}  data URI), bypass with --no-verify after operator review.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # 5. Check for .env files being committed
  ENV_FILES=$(git diff --name-only "$range" 2>/dev/null | grep -E '\.env' || true)
  if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}BLOCKED: .env file(s) in commit:${NC}"
    echo "$ENV_FILES"
    echo ""
    ISSUES=$((ISSUES + 1))
  fi

  # 7. Block client identifiers from PUBLIC paths.
  #    The 2026-05-04 Seepje leak was caused by hardcoded client content in
  #    dpa-intake.html / dpa-contract.html / assets/js/dpa-pdf-builder.js
  #    reaching origin/main and being publicly indexed. This check ensures
  #    NO file destined for public hosting contains real client identifiers.
  #
  #    Exempted directories:
  #      - dpa/ops/*    — operator admin tool (own stricter checks at 6.4-6.5
  #                        + noindex robots meta + admin-secret gate)
  #      - audit-log/*  — internal QA artifacts (gitignored anyway, defense
  #                        in depth in case .gitignore is bypassed)
  #      - design-lab/* — internal dev tooling (gitignored anyway)
  #      - node_modules, assets/js/vendor/* — third-party
  #      - .gitignore   — pattern names may legitimately mention client slugs
  #                        (the gitignore is itself the protection — patterns
  #                        prevent the named files from being committed)
  #
  #    Closed identifier vocabulary. UPDATE THIS REGEX when a new voucher
  #    client onboards (mirror against dpa/ops/clients.json). Tests run via:
  #      echo 'voucher/seepje' | grep -iE "$CLIENT_IDENTIFIERS_RE"
  CLIENT_IDENTIFIERS_RE='seepje|houtgoed|evsmart|engelvaart|hollands.?wol[^a-z]|kvw3-[0-9]{5}'
  # Note: 'kvw3-[0-9]{5}' matches voucher numbers like KVW3-00568 / KVW3-00614
  # but NOT the public framework name "KvW3-DPP-voucher" or "KvW3-context".
  # The KvW3 (Kansen voor West 3) ERDF programme is publicly named; only the
  # per-client voucher number is the leak vector. (Tightened 2026-05-04 after
  # Path A v0.2 contract template referenced the public KvW3 framework name.)

  # B-PT2 fix (2026-05-05 new-lens audit): PUBLIC_DIFF MUST be defined BEFORE
  # any check that consumes it. Earlier ordering had the R2 extension blocks
  # (TERMINOLOGY_LEAK_RE / DATE_LEAK_RE / PLACEHOLDER_RE) reading $PUBLIC_DIFF
  # while it was still undefined — bash undefined-var expanded to empty,
  # `echo "" | grep ...` returned empty, all three extensions silently disabled.
  # Defining here, BEFORE any use, makes every leak-class scan actually run.
  PUBLIC_DIFF=$(git diff "$range" -- \
    '*.html' '*.js' '*.ts' '*.json' '*.css' '*.md' '*.txt' '*.svg' \
    ':!dpa/ops/*' ':!audit-log/*' ':!design-lab/*' \
    ':!node_modules/*' ':!assets/js/vendor/*' ':!.gitignore' 2>/dev/null)

  # Audit Round-3 R2 extension (2026-05-04 audit-final): broader pattern
  # catches client-specific Dutch terminology + dates + regime-specific
  # keywords that the slug regex above missed in Round 1. These are leak
  # classes the publishing-sensitive-info persona surfaced.
  TERMINOLOGY_LEAK_RE='formulering-recept|CLP-bedrijfs|surfactant.{0,40}leverancier|NVZ\b|PEFCR\b|DSR-register-status'
  TERMINOLOGY_LEAKS=$(echo "$PUBLIC_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | \
    grep -niE "$TERMINOLOGY_LEAK_RE" || true)
  if [ -n "$TERMINOLOGY_LEAKS" ]; then
    echo -e "${RED}BLOCKED: Client-terminology leak in public-facing file(s):${NC}"
    echo "$TERMINOLOGY_LEAKS" | head -20
    echo ""
    echo -e "${YELLOW}  These Dutch terms are tightly linked to specific voucher clients${NC}"
    echo -e "${YELLOW}  (detergents/surfactants, building products, etc.). Use the${NC}"
    echo -e "${YELLOW}  regime-derived sensitiveDataExclusionNarrativeNl from the${NC}"
    echo -e "${YELLOW}  engagement profile instead of inlining client-domain language.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # Audit Round-3 R2 extension: hardcoded contract-engagement dates leak
  # the underlying engagement (e.g. specific project-end / bewaarplicht /
  # beschikking dates). These come from the engagement profile at runtime;
  # should never be in static markup.
  #
  # 2026-05-20 exemption: PUBLIC EU regulation milestone dates (ESPR Art 79
  # transition, PPWR / CPR / Battery / Toy DPP cutoff dates) are not engagement
  # leaks — they appear verbatim across the public trilingual DPP pages and
  # are sourced from eur-lex. The grep -v below excludes lines that also
  # contain unambiguous EU-regulation-context markers (regulation number,
  # eur-lex URL, named regulation acronym in a regulatory phrase). Engagement
  # leaks would normally cite a beschikking number or voucher code (KvW3-...)
  # — those are caught by the CLIENT_IDENTIFIERS_RE check above and are NOT
  # whitelisted here.
  DATE_LEAK_RE='\b(1|2|3|31)\s+(jan|feb|mrt|apr|mei|jun|jul|aug|sep|okt|nov|dec)(uari|ruari|aart|il|i|ni|li|ustus|tember|tober|ember)?\s+(202[6-9]|203[0-9])'
  DATE_LEAK_PUBLIC_CONTEXT_RE='eur-lex\.europa\.eu|Ecodesign-richtlijn|ESPR(\s|-)|PPWR|CPR\s+2024/3110|Batterijenverordening|Battery\s+Regulation|Speelgoedveiligheidsverordening|Toy\s+Safety|Artikel\s+(18|25|79|9|10|11|12|13|14)\b|Article\s+(18|25|79|9|10|11|12|13|14)\b|art\.\s+(8|21|22|24|25|30|34|36|37)\b|Verordening\s+\(EU\)\s+202[0-9]/[0-9]+|Regulation\s+\(EU\)\s+202[0-9]/[0-9]+|Energiewet|Elektriciteitswet|Gaswet|nieuwe\s+Energiewet|Algemene\s+Voorwaarden|Versie\s+[0-9][0-9]*\.[0-9][0-9]*|v[0-9][0-9]*\.[0-9][0-9]*\s+(NL|EN|PT)'
  DATE_LEAKS=$(echo "$PUBLIC_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | \
    grep -nE "$DATE_LEAK_RE" | \
    grep -vE "$DATE_LEAK_PUBLIC_CONTEXT_RE" || true)
  if [ -n "$DATE_LEAKS" ]; then
    echo -e "${RED}BLOCKED: Hardcoded contract-engagement date in public-facing file(s):${NC}"
    echo "$DATE_LEAKS" | head -20
    echo ""
    echo -e "${YELLOW}  Engagement-specific dates (project end, bewaarplicht, beschikking)${NC}"
    echo -e "${YELLOW}  belong in the engagement profile, not in static markup.${NC}"
    echo -e "${YELLOW}  Use [data-tpl="project_einddatum_label"] etc. with profile injection.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # Placeholder hygiene: the prior 'PENDING_BUILDTIME_PIN_*' string class
  # would silently store as the per-document SHA in dpa_signatures, partly
  # undermining the §17 integrity claim. Block at hook level.
  PLACEHOLDER_RE='PENDING_BUILDTIME_PIN|TODO_REPLACE_BEFORE|FIXME_BEFORE_PUBLISH'
  PLACEHOLDER_LEAKS=$(echo "$PUBLIC_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | \
    grep -nE "$PLACEHOLDER_RE" || true)
  if [ -n "$PLACEHOLDER_LEAKS" ]; then
    echo -e "${RED}BLOCKED: Deploy-time placeholder string in public-facing file(s):${NC}"
    echo "$PLACEHOLDER_LEAKS" | head -10
    ISSUES=$((ISSUES + 1))
  fi

  # Phase 5 drift guard (2026-05-05): the DPA legal text MUST come from
  # dpa-test-content/*.md via the parser → AST → renderer pipeline, NEVER
  # hardcoded in the renderer code. Earlier today the previous pdf-builder.js
  # held 1.6k lines of hardcoded Dutch that drifted from canonical-NL.md as
  # comment-fixes landed; the resulting signed PDFs didn't reflect reviewed
  # text. This guard blocks any commit that adds Dutch legal-clause patterns
  # (AVG/eIDAS/Vo (EU) citations, multi-word legal phrases) to the two
  # renderer files. UI-label strings ("Verwerkersovereenkomst", "REGEN
  # STUDIO", "Handtekeningen") are short + structural — they don't match
  # these patterns.
  RENDERER_DIFF=$(git diff "$range" -- \
    'assets/js/dpa-pdf-renderer.js' \
    'assets/js/dpa-md-render.js' \
    'assets/js/dpa-pdf-builder.js' 2>/dev/null)
  # Catch true clause language only: defined-term subject + obligation verb,
  # or explicit "Partijen komen overeen". Standalone citations like
  # "Artikel 28 AVG" are allowed because they appear in legitimate UI
  # labels (cover subtitle, signature attestation) — those are structural
  # metadata, not binding clauses.
  LEGAL_TEXT_RE='(De\s+Verwerker|De\s+Verantwoordelijke)\s+(verklaart|instrueert|garandeert|verleent|verbindt|verplicht|stelt|treft|meldt|ondersteunt|bevestigt)|Partijen\s+komen\s+overeen|Bij\s+conflict\s+tussen|Deze\s+Overeenkomst\s+(treedt|wordt|regelt|legt)'
  RENDERER_LEGAL=$(echo "$RENDERER_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | \
    grep -nE "$LEGAL_TEXT_RE" || true)
  if [ -n "$RENDERER_LEGAL" ]; then
    echo -e "${RED}BLOCKED: Dutch legal-clause text added to renderer code:${NC}"
    echo "$RENDERER_LEGAL" | head -10
    echo ""
    echo -e "${YELLOW}  Renderer files (dpa-pdf-renderer.js, dpa-md-render.js,${NC}"
    echo -e "${YELLOW}  dpa-pdf-builder.js) MUST NOT contain DPA legal text. Binding${NC}"
    echo -e "${YELLOW}  text lives in dpa-test-content/*.md and flows through the${NC}"
    echo -e "${YELLOW}  parser → AST → renderer pipeline. UI labels are fine, but${NC}"
    echo -e "${YELLOW}  AVG/eIDAS/Vo (EU) citations + clause language belong in canonical.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # Only scan ADDED lines (lines starting '+', excluding diff headers '+++').
  # Removals are takedown wins, not violations.
  LEAK_HITS=$(echo "$PUBLIC_DIFF" | grep -E '^\+' | grep -vE '^\+\+\+' | \
    grep -niE "$CLIENT_IDENTIFIERS_RE" || true)
  if [ -n "$LEAK_HITS" ]; then
    echo -e "${RED}BLOCKED: Client identifier(s) in public-facing file(s):${NC}"
    echo "$LEAK_HITS" | head -20
    echo ""
    echo -e "${YELLOW}  Public DPA / contract / asset paths must be GENERIC TEMPLATES${NC}"
    echo -e "${YELLOW}  that load client data at runtime from authenticated Edge${NC}"
    echo -e "${YELLOW}  Functions (e.g. dpa-verify-token returns the engagement profile).${NC}"
    echo -e "${YELLOW}  Client-specific content stays in dpa/ops/clients.json (covered${NC}"
    echo -e "${YELLOW}  by check 6.5) or in Edge Function source (gitignored).${NC}"
    echo ""
    echo -e "${YELLOW}  This guard was added 2026-05-04 after a hardcoded-Seepje leak${NC}"
    echo -e "${YELLOW}  reached origin/main. Do NOT bypass with --no-verify unless you${NC}"
    echo -e "${YELLOW}  have confirmed the match is in a case-study / blog-post context${NC}"
    echo -e "${YELLOW}  with documented naming_allowed consent for that subject.${NC}"
    ISSUES=$((ISSUES + 1))
  fi

  # 6. Block publishing unreviewed blog content.
  #    Any added/modified blog/<slug>/index.html (or nl/blog, pt/blog) requires
  #    Blogs/<slug>/meta[.lang].json to have published:true AND review.text/assets:approved
  #    at the pushed sha. Same check for slugs newly added to Blogs/blogs.json.
  PAGE_CHECKS=$(git diff --name-only --diff-filter=AM "$range" 2>/dev/null | grep -E '^(blog|nl/blog|pt/blog)/[^/]+/index\.html$' || true)
  CHECK_PAIRS=""
  if [ -n "$PAGE_CHECKS" ]; then
    while IFS= read -r file; do
      prefix=$(echo "$file" | cut -d/ -f1)
      if [ "$prefix" = "blog" ]; then
        lang="en"; slug=$(echo "$file" | cut -d/ -f2)
      else
        lang="$prefix"; slug=$(echo "$file" | cut -d/ -f3)
      fi
      CHECK_PAIRS=$(printf '%s\n%s\t%s' "$CHECK_PAIRS" "$slug" "$lang")
    done <<< "$PAGE_CHECKS"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^Blogs/blogs\.json$'; then
    NEW_SLUGS=$(python3 - "$local_sha" "$remote_sha" <<'PYEOF' 2>/dev/null || true
import json, subprocess, sys
def get(sha):
    if sha == '0000000000000000000000000000000000000000': return set()
    try:
        return set(json.loads(subprocess.check_output(['git', 'show', f'{sha}:Blogs/blogs.json'], stderr=subprocess.DEVNULL)))
    except Exception:
        return set()
for s in get(sys.argv[1]) - get(sys.argv[2]):
    print(s)
PYEOF
)
    if [ -n "$NEW_SLUGS" ]; then
      while IFS= read -r slug; do
        [ -z "$slug" ] && continue
        CHECK_PAIRS=$(printf '%s\n%s\ten' "$CHECK_PAIRS" "$slug")
      done <<< "$NEW_SLUGS"
    fi
  fi
  if [ -n "$CHECK_PAIRS" ]; then
    while IFS=$'\t' read -r slug lang; do
      [ -z "$slug" ] && continue
      if [ "$lang" = "en" ]; then
        meta_path="Blogs/$slug/meta.json"
      else
        meta_path="Blogs/$slug/meta.$lang.json"
      fi
      meta=$(git show "$local_sha:$meta_path" 2>/dev/null || true)
      if [ -z "$meta" ]; then
        echo -e "${RED}BLOCKED: $slug ($lang) — $meta_path missing at push sha${NC}"
        ISSUES=$((ISSUES + 1))
        continue
      fi
      result=$(echo "$meta" | python3 -c "
import json, sys
try: d = json.load(sys.stdin)
except Exception as e: print(f'PARSE_ERROR: {e}'); sys.exit(0)
pub = d.get('published', False)
r = d.get('review', {}) or {}
if pub and r.get('text') == 'approved' and r.get('assets') == 'approved': print('OK')
else: print(f'published={pub} review.text={r.get(\"text\")} review.assets={r.get(\"assets\")}')
" 2>/dev/null)
      if [ "$result" != "OK" ]; then
        echo -e "${RED}BLOCKED: $slug ($lang) not cleared for publish: $result${NC}"
        ISSUES=$((ISSUES + 1))
      fi
    done < <(echo "$CHECK_PAIRS" | sort -u | grep -v '^$')
  fi

  # 8. Lang-completeness gate for top-level static pages.
  #    Every top-level <slug>/index.html added or modified must have matching
  #    nl/<slug>/index.html AND pt/<slug>/index.html in the tree at the push SHA.
  #    Exempt slugs list at scripts/hooks/en-only-pages.txt (one slug per line,
  #    # comments + blank lines OK).
  #    Codified 2026-05-20 after the 8-page NL/PT trilingualisation sweep —
  #    new public-facing pages were repeatedly authored EN-only and shipped
  #    without translations, breaking the runtime language switcher.
  ALLOWLIST_FILE="scripts/hooks/en-only-pages.txt"
  ALLOWLIST=""
  if [ -f "$ALLOWLIST_FILE" ]; then
    ALLOWLIST=$(grep -vE '^\s*(#|$)' "$ALLOWLIST_FILE" 2>/dev/null || true)
  fi

  TOP_LEVEL_NEW=$(git diff --name-only --diff-filter=AM "$range" 2>/dev/null \
    | grep -E '^[a-z0-9][a-z0-9-]*/index\.html$' || true)

  if [ -n "$TOP_LEVEL_NEW" ]; then
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      slug=$(echo "$file" | cut -d/ -f1)
      if [ -n "$ALLOWLIST" ] && echo "$ALLOWLIST" | grep -Fxq "$slug"; then
        continue
      fi
      missing=""
      git cat-file -e "$local_sha:nl/$slug/index.html" 2>/dev/null || missing="$missing nl"
      git cat-file -e "$local_sha:pt/$slug/index.html" 2>/dev/null || missing="$missing pt"
      if [ -n "$missing" ]; then
        echo -e "${RED}BLOCKED: lang-completeness — $slug exists in EN but missing in:$missing${NC}"
        echo -e "${YELLOW}  Add the missing variant(s) (nl/$slug/index.html, pt/$slug/index.html)${NC}"
        echo -e "${YELLOW}  or add '$slug' on its own line in scripts/hooks/en-only-pages.txt${NC}"
        echo -e "${YELLOW}  to opt out (e.g. for internal admin/operator pages).${NC}"
        ISSUES=$((ISSUES + 1))
      fi
    done <<< "$TOP_LEVEL_NEW"
  fi

  # 9. SKILL.md supply-chain scan (global skills.md rule).
  #    Any added/modified **/SKILL.md must be scanned for the three "scary
  #    agent skills" vectors: hidden Unicode (zero-width / bidi / RTL-override),
  #    inline downloaders/executors in fenced code, and secret-shaped strings.
  #    The mandated scan was absent from this hook until the 2026-06-10 audit.
  SKILL_SCANNER="$(git rev-parse --show-toplevel)/scripts/hooks/skill-scan.py"
  SKILL_FILES=$(git diff --name-only --diff-filter=AM "$range" 2>/dev/null | grep -E '(^|/)SKILL\.md$' || true)
  if [ -n "$SKILL_FILES" ] && [ -f "$SKILL_SCANNER" ]; then
    while IFS= read -r skill_file; do
      [ -z "$skill_file" ] && continue
      SCAN_OUT=$(git show "$local_sha:$skill_file" 2>/dev/null | python3 "$SKILL_SCANNER" 2>/dev/null || true)
      if [ -n "$SCAN_OUT" ]; then
        echo -e "${RED}BLOCKED: SKILL.md supply-chain scan flagged $skill_file:${NC}"
        echo "$SCAN_OUT" | sed 's/^/    /' | head -10
        echo ""
        echo -e "${YELLOW}  Per skills.md: SKILL.md must not carry hidden Unicode,${NC}"
        echo -e "${YELLOW}  inline downloaders, or secret-shaped strings. Investigate${NC}"
        echo -e "${YELLOW}  the source before pushing — do NOT bypass with --no-verify.${NC}"
        ISSUES=$((ISSUES + 1))
      fi
    done <<< "$SKILL_FILES"
  fi

done

if [ "$ISSUES" -gt 0 ]; then
  echo -e "${RED}Push blocked: $ISSUES issue(s) found. Review the warnings above.${NC}"
  echo -e "To push anyway (if these are false positives): ${YELLOW}git push --no-verify${NC}"
  echo ""
  exit 1
fi

echo -e "${GREEN}Security scan passed. Pushing...${NC}"
echo ""
exit 0
